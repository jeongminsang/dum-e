{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@earendil-works/chord": ["../chord/dist/index.d.ts"],
			"@earendil-works/chord/bundler": ["../chord/dist/bundler.d.ts"],
			"@earendil-works/chord/node": ["../chord/dist/node.d.ts"],
			"@dum-e/agent-core": ["../agent/dist/index.d.ts"],
			"@dum-e/agent-core/*": ["../agent/dist/*.d.ts"],
			"@dum-e/ai": ["../ai/dist/index.d.ts"],
			"@dum-e/ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@dum-e/tui": ["../tui/dist/index.d.ts"],
			"@dum-e/tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist", "src/client", "src/experimental", "src/cli/experimental"]
}
