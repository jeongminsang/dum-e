# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell and Python scripts
*.sh text eol=lf
*.py text eol=lf

# Common binary assets & archives
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar.gz binary
*.db binary
*.sqlite binary
