#!/bin/sh

echo "Running native Rust check and test..."
cargo check --workspace --locked --offline
if [ $? -ne 0 ]; then
  echo "❌ cargo check failed. Please fix compilation errors before committing."
  exit 1
fi

# Unset Git hook environment variables so nested git worktree commands in tests use target repo configs
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR

cargo test --workspace --locked --offline
if [ $? -ne 0 ]; then
  echo "❌ cargo test failed. Please fix test failures before committing."
  exit 1
fi

echo "✅ All native Rust pre-commit checks passed!"
